# Copy to deploy/.env (git-ignored) and fill in. Never commit real values.
STOREFRONT_BRANCH_CODE=HOSP01
STOREFRONT_BRANCH_CURRENCY=USD
STOREFRONT_BRANCH_ZONE=America/New_York
STOREFRONT_NODE_ID=edge-hosp01-a
# Must match deploy/secrets/db_password
STOREFRONT_DB_PASSWORD=
# Empty = offline mode (HQ events stay queued in the outbox)
STOREFRONT_HQ_URL=
STOREFRONT_HQ_API_KEY=
# First start only: >= 32 random chars, e.g. `openssl rand -base64 33`. Remove after provisioning devices.
STOREFRONT_BOOTSTRAP_MANAGER_KEY=
